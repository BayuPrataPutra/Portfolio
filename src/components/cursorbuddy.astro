<!-- ========================================================= -->
<!-- CURSOR BUDDY                                              -->
<!-- Desktop Only - Right Side                                 -->
<!-- ========================================================= -->

<div
  id="cursor-buddy"
  class="cursor-buddy"
  aria-hidden="true"
>
  <!-- Speech Bubble -->
  <div
    id="buddy-message"
    class="buddy-message"
    data-en="Hi! 👋"
    data-id="Halo! 👋"
  >
    Hi! 👋
  </div>

  <!-- Character -->
  <div
    id="buddy-body"
    class="buddy-body"
  >
    <div class="buddy-glow"></div>

    <!-- Antenna -->
    <div class="antenna">
      <span></span>
    </div>

    <!-- Face -->
    <div class="buddy-face">
      <div class="eye">
        <div class="pupil"></div>
      </div>

      <div class="eye">
        <div class="pupil"></div>
      </div>
    </div>

    <!-- Mouth -->
    <div
      id="buddy-mouth"
      class="buddy-mouth"
    ></div>

    <!-- Legs -->
    <div class="buddy-legs">
      <span></span>
      <span></span>
    </div>
  </div>
</div>


<!-- ========================================================= -->
<!-- SURPRISE OVERLAY                                          -->
<!-- ========================================================= -->

<div
  id="buddy-surprise"
  class="buddy-surprise"
  aria-hidden="true"
>
  <div class="surprise-card">

    <div class="surprise-robot">
      🤖
    </div>

    <p
      id="surprise-label"
      class="surprise-label"
      data-en="SECRET MODE UNLOCKED"
      data-id="MODE RAHASIA TERBUKA"
    >
      SECRET MODE UNLOCKED
    </p>

    <h2
      id="surprise-title"
      data-en="BUDDY OVERLOAD!"
      data-id="BUDDY OVERLOAD!"
    >
      BUDDY OVERLOAD!
    </h2>

    <p
      id="surprise-description"
      class="surprise-description"
      data-en="You clicked the little robot too many times."
      data-id="Kamu terlalu sering mengganggu robot kecil ini."
    >
      You clicked the little robot too many times.
    </p>

  </div>
</div>


<script>
  /* ========================================================= */
  /* ELEMENTS                                                  */
  /* ========================================================= */

  const buddy =
    document.getElementById(
      "cursor-buddy"
    )!;

  const buddyBody =
    document.getElementById(
      "buddy-body"
    )!;

  const buddyMessage =
    document.getElementById(
      "buddy-message"
    )!;

  const buddyMouth =
    document.getElementById(
      "buddy-mouth"
    );

  const surpriseOverlay =
    document.getElementById(
      "buddy-surprise"
    );

  const surpriseLabel =
    document.getElementById(
      "surprise-label"
    );

  const surpriseTitle =
    document.getElementById(
      "surprise-title"
    );

  const surpriseDescription =
    document.getElementById(
      "surprise-description"
    );

  const pupils =
    document.querySelectorAll<HTMLElement>(
      ".pupil"
    );


  /* ========================================================= */
  /* LANGUAGE                                                  */
  /* ========================================================= */

  type Language =
    "en" | "id";

  interface BuddyMessage {
    en: string;
    id: string;
  }


  function getLanguage():
    Language {

    return document.documentElement.lang === "id"
      ? "id"
      : "en";
  }


  /* ========================================================= */
  /* BUDDY TEXTS                                               */
  /* ========================================================= */

  const buddyTexts = {

    initial: {
      en: "Hi! I'll stay over here 👋",
      id: "Halo! Aku di sebelah sini aja ya 👋",
    },

    click1: {
      en: "HEY! 😳",
      id: "WOI! 😳",
    },

    click2: {
      en: "WOAAAAH 🫨",
      id: "WOOOAAAH 🫨",
    },

    click3: {
      en: "STOP POKING ME 😤",
      id: "JANGAN PENCET AKU TERUS 😤",
    },

    click4: {
      en: "I wouldn't do that again... 👀",
      id: "Kalau aku jadi kamu, aku tidak klik lagi... 👀",
    },

    overload: {
      en: "WHAT HAVE YOU DONE?! 😱",
      id: "APA YANG KAMU LAKUKAN?! 😱",
    },

    afterOverload: {
      en: "Let's never speak about that. 😐",
      id: "Kita anggap itu tidak pernah terjadi. 😐",
    },

  } satisfies Record<
    string,
    BuddyMessage
  >;


  /* ========================================================= */
  /* RANDOM MESSAGES                                           */
  /* ========================================================= */

  const randomMessages:
    BuddyMessage[] = [

    {
      en: "Just hanging out here 👀",
      id: "Aku nongkrong di sini aja 👀",
    },

    {
      en: "Don't mind me 🤖",
      id: "Jangan hiraukan aku 🤖",
    },

    {
      en: "Keep scrolling!",
      id: "Lanjut scroll!",
    },

    {
      en: "Beep boop.",
      id: "Bip bop.",
    },

    {
      en: "I'm guarding this side.",
      id: "Aku jaga bagian sini.",
    },

    {
      en: "Need coffee? ☕",
      id: "Butuh kopi? ☕",
    },

    {
      en: "No bugs here... probably.",
      id: "Tidak ada bug di sini... mungkin.",
    },

    {
      en: "Nice portfolio, right? 😎",
      id: "Portfolionya keren kan? 😎",
    },

    {
      en: "I'm definitely working.",
      id: "Aku benar-benar sedang kerja.",
    },

    {
      en: "Deploy on Friday? 😨",
      id: "Deploy hari Jumat? 😨",
    },

    {
      en: "Another scroll? Let's go! 🚀",
      id: "Scroll lagi? Ayo! 🚀",
    },

    {
      en: "I'm not a bug, I promise.",
      id: "Aku bukan bug, serius.",
    },

    {
      en: "Still here? Nice. 👀",
      id: "Masih di sini? Mantap. 👀",
    },

  ];


  /* ========================================================= */
  /* CURRENT MESSAGE                                           */
  /* ========================================================= */

  let currentMessage:
    BuddyMessage | null =
    null;

  let messageTimeout:
    ReturnType<typeof setTimeout>;


  function renderCurrentMessage() {

    if (!currentMessage) {
      return;
    }

    const language =
      getLanguage();

    buddyMessage.textContent =
      currentMessage[language];
  }


  /* ========================================================= */
  /* SHOW MESSAGE                                              */
  /* ========================================================= */

  function showMessage(
    message: BuddyMessage,
    duration = 2000
  ) {

    currentMessage =
      message;

    renderCurrentMessage();

    buddyMessage.classList.add(
      "show"
    );

    clearTimeout(
      messageTimeout
    );

    messageTimeout =
      setTimeout(
        () => {

          buddyMessage.classList.remove(
            "show"
          );

        },
        duration
      );
  }


  /* ========================================================= */
  /* RANDOM MESSAGE                                            */
  /* ========================================================= */

  function showRandomMessage() {

    const randomMessage =
      randomMessages[
        Math.floor(
          Math.random() *
          randomMessages.length
        )
      ];

    showMessage(
      randomMessage,
      2200
    );
  }


  /* ========================================================= */
  /* SURPRISE TRANSLATION                                      */
  /* ========================================================= */

  function updateSurpriseLanguage() {

    const language =
      getLanguage();


    if (surpriseLabel) {

      surpriseLabel.textContent =
        language === "id"
          ? "MODE RAHASIA TERBUKA"
          : "SECRET MODE UNLOCKED";

    }


    if (surpriseTitle) {

      surpriseTitle.textContent =
        "BUDDY OVERLOAD!";

    }


    if (surpriseDescription) {

      surpriseDescription.textContent =
        language === "id"
          ? "Kamu terlalu sering mengganggu robot kecil ini."
          : "You clicked the little robot too many times.";

    }

  }


  /* ========================================================= */
  /* LANGUAGE CHANGE EVENT                                     */
  /* ========================================================= */

  window.addEventListener(
    "portfolio-language-change",
    () => {

      /*
        Kalau bubble sedang tampil,
        langsung ganti bahasanya.
      */

      if (
        buddyMessage.classList.contains(
          "show"
        )
      ) {

        renderCurrentMessage();

      }


      /*
        Surprise juga langsung
        mengikuti bahasa baru.
      */

      updateSurpriseLanguage();

    }
  );


  /* ========================================================= */
  /* POSITION                                                  */
  /* ========================================================= */

  let currentX =
    window.innerWidth - 110;

  let currentY =
    window.innerHeight / 2;

  let targetX =
    currentX;

  let targetY =
    currentY;


  function chooseRandomPosition() {

    /*
      Buddy hanya bergerak
      di area kanan layar.
    */

    const minX =
      window.innerWidth - 145;

    const maxX =
      window.innerWidth - 80;


    /*
      Menghindari navbar
      dan bagian paling bawah.
    */

    const minY =
      120;

    const maxY =
      Math.max(
        minY,
        window.innerHeight - 120
      );


    targetX =
      minX +
      Math.random() *
        (
          maxX -
          minX
        );


    targetY =
      minY +
      Math.random() *
        (
          maxY -
          minY
        );

  }


  /* ========================================================= */
  /* MOVEMENT                                                  */
  /* ========================================================= */

  function animateBuddy() {

    const speed =
      0.008;


    currentX +=
      (
        targetX -
        currentX
      ) *
      speed;


    currentY +=
      (
        targetY -
        currentY
      ) *
      speed;


    buddy.style.transform =
      `translate3d(${currentX}px, ${currentY}px, 0)`;


    requestAnimationFrame(
      animateBuddy
    );

  }


  chooseRandomPosition();

  animateBuddy();


  /* ========================================================= */
  /* RANDOM WALK                                               */
  /* ========================================================= */

  function scheduleMovement() {

    const delay =
      3500 +
      Math.random() *
        3500;


    setTimeout(
      () => {

        chooseRandomPosition();

        scheduleMovement();

      },
      delay
    );

  }


  scheduleMovement();


  /* ========================================================= */
  /* RANDOM EYE MOVEMENT                                       */
  /* ========================================================= */

  function moveEyes() {

    const x =
      Math.random() *
        6 -
      3;

    const y =
      Math.random() *
        5 -
      2.5;


    pupils.forEach(
      (pupil) => {

        pupil.style.transform =
          `translate(${x}px, ${y}px)`;

      }
    );

  }


  setInterval(
    moveEyes,
    1600
  );


  /* ========================================================= */
  /* RANDOM TALK                                               */
  /* ========================================================= */

  function scheduleMessage() {

    const delay =
      9000 +
      Math.random() *
        9000;


    setTimeout(
      () => {

        /*
          Buddy tidak selalu bicara.
        */

        if (
          Math.random() >
          0.35
        ) {

          showRandomMessage();

        }


        scheduleMessage();

      },
      delay
    );

  }


  scheduleMessage();


  /* ========================================================= */
  /* RESET REACTION                                            */
  /* ========================================================= */

  function resetReaction() {

    buddyBody.classList.remove(
      "reaction-jump",
      "reaction-spin",
      "reaction-angry",
      "reaction-suspicious",
      "reaction-overload"
    );


    buddyMouth?.classList.remove(
      "mouth-shocked",
      "mouth-angry",
      "mouth-happy"
    );

  }


  /* ========================================================= */
  /* PARTICLE BURST                                            */
  /* ========================================================= */

  function createParticles(
    amount = 8
  ) {

    const rect =
      buddyBody.getBoundingClientRect();


    const centerX =
      rect.left +
      rect.width / 2;

    const centerY =
      rect.top +
      rect.height / 2;


    const symbols = [
      "✦",
      "✧",
      "★",
      "✨",
      "◇",
    ];


    for (
      let i = 0;
      i < amount;
      i++
    ) {

      const particle =
        document.createElement(
          "span"
        );


      particle.className =
        "buddy-particle";


      particle.textContent =
        symbols[
          Math.floor(
            Math.random() *
            symbols.length
          )
        ];


      particle.style.left =
        `${centerX}px`;

      particle.style.top =
        `${centerY}px`;


      particle.style.setProperty(
        "--particle-x",
        `${
          Math.random() *
            150 -
          75
        }px`
      );


      particle.style.setProperty(
        "--particle-y",
        `${
          -30 -
          Math.random() *
            110
        }px`
      );


      document.body.appendChild(
        particle
      );


      setTimeout(
        () => {

          particle.remove();

        },
        900
      );

    }

  }


  /* ========================================================= */
  /* CONFETTI                                                  */
  /* ========================================================= */

  function createConfetti() {

    const symbols = [
      "●",
      "■",
      "▲",
      "✦",
      "◆",
      "★",
    ];


    const confetti =
      document.createElement(
        "span"
      );


    confetti.className =
      "buddy-confetti";


    confetti.textContent =
      symbols[
        Math.floor(
          Math.random() *
          symbols.length
        )
      ];


    confetti.style.left =
      `${Math.random() * 100}vw`;


    confetti.style.setProperty(
      "--confetti-x",
      `${
        Math.random() *
          180 -
        90
      }px`
    );


    confetti.style.animationDuration =
      `${
        1.8 +
        Math.random() *
          1.2
      }s`;


    document.body.appendChild(
      confetti
    );


    setTimeout(
      () => {

        confetti.remove();

      },
      3200
    );

  }


  /* ========================================================= */
  /* SURPRISE                                                  */
  /* ========================================================= */

  function triggerSurprise() {

    resetReaction();


    buddyBody.classList.add(
      "reaction-overload"
    );


    buddyMouth?.classList.add(
      "mouth-happy"
    );


    showMessage(
      buddyTexts.overload
    );


    createParticles(
      25
    );


    /*
      Pastikan bahasa surprise
      mengikuti language sekarang.
    */

    updateSurpriseLanguage();


    /* Confetti */

    for (
      let i = 0;
      i < 60;
      i++
    ) {

      setTimeout(
        () => {

          createConfetti();

        },
        i * 18
      );

    }


    /* Open Overlay */

    setTimeout(
      () => {

        surpriseOverlay
          ?.classList.add(
            "show"
          );

      },
      400
    );


    /* Close Overlay */

    setTimeout(
      () => {

        surpriseOverlay
          ?.classList.remove(
            "show"
          );

      },
      2700
    );


    /* Final Message */

    setTimeout(
      () => {

        resetReaction();


        showMessage(
          buddyTexts.afterOverload,
          2500
        );

      },
      3100
    );

  }


  /* ========================================================= */
  /* CLICK REACTIONS                                           */
  /* ========================================================= */

  let clickCount =
    0;


  buddyBody.addEventListener(
    "click",
    (event) => {

      event.stopPropagation();


      clickCount++;


      resetReaction();


      /*
        Force reflow supaya animasi
        bisa dijalankan ulang.
      */

      void buddyBody.offsetWidth;


      /* ===================================================== */
      /* CLICK 1                                               */
      /* ===================================================== */

      if (
        clickCount === 1
      ) {

        buddyBody.classList.add(
          "reaction-jump"
        );


        buddyMouth?.classList.add(
          "mouth-shocked"
        );


        showMessage(
          buddyTexts.click1
        );


        createParticles(
          5
        );

      }


      /* ===================================================== */
      /* CLICK 2                                               */
      /* ===================================================== */

      else if (
        clickCount === 2
      ) {

        buddyBody.classList.add(
          "reaction-spin"
        );


        buddyMouth?.classList.add(
          "mouth-shocked"
        );


        showMessage(
          buddyTexts.click2
        );


        createParticles(
          8
        );

      }


      /* ===================================================== */
      /* CLICK 3                                               */
      /* ===================================================== */

      else if (
        clickCount === 3
      ) {

        buddyBody.classList.add(
          "reaction-angry"
        );


        buddyMouth?.classList.add(
          "mouth-angry"
        );


        showMessage(
          buddyTexts.click3
        );

      }


      /* ===================================================== */
      /* CLICK 4                                               */
      /* ===================================================== */

      else if (
        clickCount === 4
      ) {

        buddyBody.classList.add(
          "reaction-suspicious"
        );


        showMessage(
          buddyTexts.click4
        );

      }


      /* ===================================================== */
      /* CLICK 5                                               */
      /* ===================================================== */

      else {

        triggerSurprise();

        clickCount =
          0;

      }


      /*
        Reaksi biasa kembali
        ke ekspresi normal.
      */

      if (
        clickCount !== 0
      ) {

        setTimeout(
          () => {

            resetReaction();

          },
          750
        );

      }

    }
  );


  /* ========================================================= */
  /* WINDOW RESIZE                                             */
  /* ========================================================= */

  window.addEventListener(
    "resize",
    () => {

      currentX =
        Math.min(
          currentX,
          window.innerWidth - 80
        );


      chooseRandomPosition();

    }
  );


  /* ========================================================= */
  /* INITIAL LANGUAGE                                          */
  /* ========================================================= */

  updateSurpriseLanguage();


  /* ========================================================= */
  /* INITIAL MESSAGE                                           */
  /* ========================================================= */

  setTimeout(
    () => {

      showMessage(
        buddyTexts.initial,
        2600
      );

    },
    1800
  );
</script>


<style>
  /* ========================================================= */
  /* BUDDY CONTAINER                                           */
  /* ========================================================= */

  .cursor-buddy {
    position: fixed;

    top: 0;
    left: 0;

    width: 70px;
    height: 70px;

    z-index: 45;

    pointer-events: none;

    will-change:
      transform;

    display: none;
  }


  /* Desktop Only */

  @media (min-width: 1024px) {
    .cursor-buddy {
      display: block;
    }
  }


  /* ========================================================= */
  /* BODY                                                      */
  /* ========================================================= */

  .buddy-body {
    position: relative;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 58px;
    height: 58px;

    border-radius:
      45% 45% 48% 48%;

    background:
      linear-gradient(
        135deg,
        #06b6d4,
        #8b5cf6
      );

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.3
      );

    box-shadow:
      0 14px 40px
      rgba(
        6,
        182,
        212,
        0.22
      );

    pointer-events: auto;

    cursor: pointer;

    transform-origin:
      center;

    transition:
      box-shadow
      0.25s ease;
  }


  .buddy-body:hover {
    box-shadow:
      0 18px 55px
      rgba(
        139,
        92,
        246,
        0.4
      );
  }


  /* ========================================================= */
  /* GLOW                                                      */
  /* ========================================================= */

  .buddy-glow {
    position: absolute;

    inset: -16px;

    z-index: -1;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(
          6,
          182,
          212,
          0.2
        ),
        transparent 65%
      );

    filter:
      blur(8px);

    pointer-events: none;
  }


  /* ========================================================= */
  /* ANTENNA                                                   */
  /* ========================================================= */

  .antenna {
    position: absolute;

    top: -12px;
    left: 50%;

    width: 2px;
    height: 14px;

    transform:
      translateX(-50%);

    background:
      rgba(
        255,
        255,
        255,
        0.7
      );

    pointer-events: none;
  }


  .antenna span {
    position: absolute;

    top: -5px;
    left: 50%;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    transform:
      translateX(-50%);

    background:
      #67e8f9;

    box-shadow:
      0 0 12px
      rgba(
        103,
        232,
        249,
        0.9
      );

    animation:
      antennaPulse
      1.8s
      ease-in-out
      infinite;
  }


  @keyframes antennaPulse {
    0%,
    100% {
      transform:
        translateX(-50%)
        scale(1);
    }

    50% {
      transform:
        translateX(-50%)
        scale(1.4);
    }
  }


  /* ========================================================= */
  /* FACE                                                      */
  /* ========================================================= */

  .buddy-face {
    display: flex;

    gap: 9px;

    margin-top: -4px;

    pointer-events: none;
  }


  .eye {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 13px;
    height: 16px;

    overflow: hidden;

    border-radius: 50%;

    background: white;
  }


  .pupil {
    width: 6px;
    height: 7px;

    border-radius: 50%;

    background:
      #020617;

    transition:
      transform
      0.3s ease;
  }


  /* ========================================================= */
  /* MOUTH                                                     */
  /* ========================================================= */

  .buddy-mouth {
    position: absolute;

    bottom: 11px;

    width: 11px;
    height: 5px;

    border-bottom:
      2px solid
      rgba(
        2,
        6,
        23,
        0.85
      );

    border-radius:
      0 0 10px 10px;

    pointer-events: none;
  }


  .buddy-mouth.mouth-shocked {
    width: 8px;
    height: 8px;

    border:
      2px solid #020617;

    border-radius:
      50%;
  }


  .buddy-mouth.mouth-angry {
    width: 13px;
    height: 5px;

    border-top:
      2px solid #020617;

    border-bottom: none;

    border-radius:
      50% 50% 0 0;
  }


  .buddy-mouth.mouth-happy {
    width: 16px;
    height: 9px;

    border-bottom-width:
      3px;
  }


  /* ========================================================= */
  /* LEGS                                                      */
  /* ========================================================= */

  .buddy-legs {
    position: absolute;

    bottom: -7px;

    display: flex;

    gap: 16px;

    pointer-events: none;
  }


  .buddy-legs span {
    width: 5px;
    height: 9px;

    border-radius:
      0 0 5px 5px;

    background:
      #7c3aed;

    animation:
      tinyWalk
      0.45s
      ease-in-out
      infinite
      alternate;
  }


  .buddy-legs span:nth-child(2) {
    animation-delay:
      0.22s;
  }


  @keyframes tinyWalk {
    from {
      transform:
        translateY(0);
    }

    to {
      transform:
        translateY(3px);
    }
  }


  /* ========================================================= */
  /* SPEECH                                                    */
  /* ========================================================= */

  .buddy-message {
    position: absolute;

    right: 50px;
    bottom: 62px;

    width:
      max-content;

    max-width:
      240px;

    padding:
      8px 12px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.12
      );

    border-radius:
      12px 12px 3px 12px;

    background:
