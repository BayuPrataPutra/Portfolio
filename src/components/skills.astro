---
interface LocalizedText {
  en: string;
  id: string;
}

interface SkillGroup {
  number: string;
  title: LocalizedText;
  description: LocalizedText;
  skills: string[];
  accent: "cyan" | "violet";
}

interface ProfessionalSkill {
  en: string;
  id: string;
}

const skillGroups: SkillGroup[] = [
  {
    number: "01",

    title: {
      en: "Programming",
      id: "Pemrograman",
    },

    description: {
      en:
        "Languages I use for software development, embedded systems, and application development.",

      id:
        "Bahasa pemrograman yang saya gunakan untuk pengembangan perangkat lunak, embedded systems, dan aplikasi.",
    },

    skills: [
      "Python",
      "Java",
      "C++",
      "C#",
      "JavaScript",
      "HTML",
      "CSS",
    ],

    accent: "cyan",
  },

  {
    number: "02",

    title: {
      en: "Machine Learning & Data",
      id: "Machine Learning & Data",
    },

    description: {
      en:
        "Tools and technologies I've used for machine learning, computer vision, and data processing.",

      id:
        "Tools dan teknologi yang saya gunakan untuk machine learning, computer vision, dan pengolahan data.",
    },

    skills: [
      "TensorFlow",
      "Keras",
      "Scikit-learn",
      "Pandas",
      "NumPy",
      "OpenCV",
      "Computer Vision",
      "Data Analysis",
    ],

    accent: "violet",
  },

  {
    number: "03",

    title: {
      en: "IoT & Embedded Systems",
      id: "IoT & Embedded Systems",
    },

    description: {
      en:
        "Hardware platforms and communication technologies used in my IoT and embedded projects.",

      id:
        "Platform perangkat keras dan teknologi komunikasi yang saya gunakan dalam berbagai proyek IoT dan embedded systems.",
    },

    skills: [
      "ESP32",
      "Arduino",
      "Raspberry Pi",
      "MQTT",
      "Sensor Integration",
    ],

    accent: "cyan",
  },

  {
    number: "04",

    title: {
      en: "Database & Development Tools",
      id: "Database & Development Tools",
    },

    description: {
      en:
        "Databases, backend services, version control, and development tools used throughout my projects.",

      id:
        "Database, layanan backend, version control, dan development tools yang saya gunakan dalam berbagai proyek.",
    },

    skills: [
      "MySQL",
      "PostgreSQL",
      "Firebase",
      "Git",
      "GitHub",
      "VS Code",
    ],

    accent: "violet",
  },
];

const professionalSkills: ProfessionalSkill[] = [
  {
    en: "Problem Solving",
    id: "Pemecahan Masalah",
  },
  {
    en: "Analytical Thinking",
    id: "Berpikir Analitis",
  },
  {
    en: "Team Collaboration",
    id: "Kolaborasi Tim",
  },
  {
    en: "Leadership",
    id: "Kepemimpinan",
  },
  {
    en: "Communication",
    id: "Komunikasi",
  },
  {
    en: "Project Management",
    id: "Manajemen Proyek",
  },
  {
    en: "Stakeholder Management",
    id: "Manajemen Stakeholder",
  },
  {
    en: "Adaptability",
    id: "Adaptabilitas",
  },
];
---

<section
  id="skills"
  class="relative py-20 sm:py-24 lg:py-28"
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- ===================================================== -->
    <!-- SECTION HEADER -->
    <!-- ===================================================== -->

    <div
      class="mb-12 flex flex-col gap-6 lg:mb-16 lg:flex-row lg:items-end lg:justify-between"
    >
      <div class="max-w-3xl">

        <!-- Label -->
        <div class="mb-3 flex items-center gap-3">

          <span
            class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400"
            data-en="Skills & Technologies"
            data-id="Keahlian & Teknologi"
          >
            Skills & Technologies
          </span>

          <div
            class="h-px w-12 bg-gradient-to-r from-cyan-500 to-transparent"
          ></div>

        </div>


        <!-- Heading -->
        <h2
          class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
        >
          <span
            data-en="Tools I use to "
            data-id="Tools yang saya gunakan untuk "
          >
            Tools I use to
          </span>

          <span
            class="bg-gradient-to-r from-cyan-400 to-violet-500 bg-clip-text text-transparent"
            data-en="build things."
            data-id="membangun sesuatu."
          >
            build things.
          </span>
        </h2>


        <!-- Description -->
        <p
          class="mt-5 max-w-2xl text-sm leading-7 text-slate-400 sm:text-base sm:leading-8"
          data-en="Technologies and tools I've worked with across software development, machine learning, Internet of Things, embedded systems, and data-driven projects."
          data-id="Teknologi dan tools yang telah saya gunakan dalam pengembangan perangkat lunak, machine learning, Internet of Things, embedded systems, dan berbagai proyek berbasis data."
        >
          Technologies and tools I've worked with across software
          development, machine learning, Internet of Things, embedded
          systems, and data-driven projects.
        </p>

      </div>


      <!-- =================================================== -->
      <!-- DECORATIVE CODE -->
      <!-- =================================================== -->

      <div
        class="hidden items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 font-mono text-xs text-slate-500 lg:flex"
        aria-hidden="true"
      >
        <span class="text-violet-400">
          const
        </span>

        <span class="text-cyan-300">
          skills
        </span>

        <span>
          =
        </span>

        <span class="text-emerald-300">
          continuousLearning
        </span>

        <span>
          ;
        </span>
      </div>

    </div>


    <!-- ===================================================== -->
    <!-- TECHNICAL SKILLS -->
    <!-- ===================================================== -->

    <div class="grid gap-5 md:grid-cols-2">

      {
        skillGroups.map((group) => (
          <article
            class:list={[
              "group relative overflow-hidden rounded-2xl border bg-slate-900/50 p-6 transition-all duration-300 sm:p-7",

              group.accent === "cyan"
                ? "border-white/10 hover:border-cyan-500/30"
                : "border-white/10 hover:border-violet-500/30",
            ]}
          >

            <!-- Decorative Glow -->
            <div
              class:list={[
                "pointer-events-none absolute -right-20 -top-20 h-44 w-44 rounded-full blur-[80px] transition-opacity duration-300",

                group.accent === "cyan"
                  ? "bg-cyan-500/10"
                  : "bg-violet-500/10",
              ]}
              aria-hidden="true"
            ></div>


            <!-- ================================================= -->
            <!-- CARD HEADER -->
            <!-- ================================================= -->

            <div class="relative flex items-start gap-4">

              <!-- Number -->
              <div
                class:list={[
                  "flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border font-mono text-xs font-semibold",

                  group.accent === "cyan"
                    ? "border-cyan-500/20 bg-cyan-500/10 text-cyan-300"
                    : "border-violet-500/20 bg-violet-500/10 text-violet-300",
                ]}
              >
                {group.number}
              </div>


              <div>

                <!-- Group Title -->
                <h3
                  class="text-lg font-bold text-white sm:text-xl"
                  data-en={group.title.en}
                  data-id={group.title.id}
                >
                  {group.title.en}
                </h3>


                <!-- Group Description -->
                <p
                  class="mt-2 max-w-md text-sm leading-6 text-slate-500"
                  data-en={group.description.en}
                  data-id={group.description.id}
                >
                  {group.description.en}
                </p>

              </div>

            </div>


            <!-- ================================================= -->
            <!-- SKILLS -->
            <!-- ================================================= -->

            <div
              class="relative mt-6 flex flex-wrap gap-2"
            >
              {
                group.skills.map((skill) => (
                  <span
                    class:list={[
                      "rounded-full border bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-400 transition-all duration-300",

                      group.accent === "cyan"
                        ? "border-white/10 hover:border-cyan-500/30 hover:bg-cyan-500/5 hover:text-cyan-200"
                        : "border-white/10 hover:border-violet-500/30 hover:bg-violet-500/5 hover:text-violet-200",
                    ]}
                  >
                    {skill}
                  </span>
                ))
              }
            </div>

          </article>
        ))
      }

    </div>


    <!-- ===================================================== -->
    <!-- PROFESSIONAL SKILLS -->
    <!-- ===================================================== -->

    <div
      class="relative mt-6 overflow-hidden rounded-2xl border border-white/10 bg-slate-900/40 p-6 sm:p-8"
    >

      <!-- Glow -->
      <div
        class="pointer-events-none absolute left-1/2 top-full h-56 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-r from-cyan-500/10 to-violet-500/10 blur-[100px]"
        aria-hidden="true"
      ></div>


      <div
        class="relative flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between"
      >

        <!-- ================================================= -->
        <!-- HEADING -->
        <!-- ================================================= -->

        <div class="max-w-sm">

          <p
            class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500"
            data-en="Beyond the Code"
            data-id="Di Luar Coding"
          >
            Beyond the Code
          </p>


          <h3
            class="mt-2 text-xl font-bold text-white sm:text-2xl"
            data-en="Professional Skills"
            data-id="Keahlian Profesional"
          >
            Professional Skills
          </h3>


          <p
            class="mt-3 text-sm leading-6 text-slate-500"
            data-en="Skills developed through academic projects, teamwork, organizational activities, and professional experience."
            data-id="Kemampuan yang saya kembangkan melalui proyek akademik, kerja sama tim, kegiatan organisasi, dan pengalaman profesional."
          >
            Skills developed through academic projects, teamwork,
            organizational activities, and professional experience.
          </p>

        </div>


        <!-- ================================================= -->
        <!-- PROFESSIONAL SKILLS LIST -->
        <!-- ================================================= -->

        <div
          class="flex max-w-2xl flex-wrap gap-2 lg:justify-end"
        >
          {
            professionalSkills.map(
              (skill) => (
                <span
                  class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-xs font-medium text-slate-300 transition-all duration-300 hover:-translate-y-0.5 hover:border-cyan-500/20 hover:bg-white/[0.07] hover:text-white sm:text-sm"
                  data-en={skill.en}
                  data-id={skill.id}
                >
                  {skill.en}
                </span>
              )
            )
          }
        </div>

      </div>

    </div>


    <!-- ===================================================== -->
    <!-- LEARNING STATEMENT -->
    <!-- ===================================================== -->

    <div
      class="mt-10 flex items-start gap-4 border-l-2 border-cyan-500/30 pl-5"
    >
      <div>

        <p
          class="text-sm leading-7 text-slate-400 sm:text-base"
          data-en="Technology keeps evolving, and so do I. I'm continuously expanding my knowledge and exploring new tools, platforms, and technologies to improve the way I build and solve problems."
          data-id="Teknologi terus berkembang, begitu juga dengan saya. Saya terus memperluas pengetahuan serta mengeksplorasi tools, platform, dan teknologi baru untuk meningkatkan cara saya membangun solusi dan menyelesaikan masalah."
        >
          Technology keeps evolving, and so do I. I'm continuously
          expanding my knowledge and exploring new tools, platforms,
          and technologies to improve the way I build and solve problems.
        </p>

      </div>
    </div>

  </div>
</section>