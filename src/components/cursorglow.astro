<div
  id="cursor-glow"
  class="cursor-glow"
  aria-hidden="true"
></div>

<script>
  const cursorGlow =
    document.getElementById(
      "cursor-glow"
    )!;

  const supportsMouse =
    window.matchMedia(
      "(hover: hover) and (pointer: fine)"
    ).matches;


  if (supportsMouse) {
    let mouseX =
      window.innerWidth / 2;

    let mouseY =
      window.innerHeight / 2;

    let glowX =
      mouseX;

    let glowY =
      mouseY;


    /* ======================================================= */
    /* MOUSE MOVE                                              */
    /* ======================================================= */

    window.addEventListener(
      "mousemove",
      (event) => {
        mouseX =
          event.clientX;

        mouseY =
          event.clientY;

        cursorGlow.classList.add(
          "visible"
        );
      },
      {
        passive: true,
      }
    );


    /* ======================================================= */
    /* SMOOTH FOLLOW                                           */
    /* ======================================================= */

    function animateGlow() {
      const followSpeed =
        0.08;

      glowX +=
        (
          mouseX -
          glowX
        ) *
        followSpeed;

      glowY +=
        (
          mouseY -
          glowY
        ) *
        followSpeed;


      cursorGlow.style.transform =
        `translate3d(${glowX}px, ${glowY}px, 0) translate(-50%, -50%)`;


      requestAnimationFrame(
        animateGlow
      );
    }


    animateGlow();


    /* ======================================================= */
    /* MOUSE LEAVE                                             */
    /* ======================================================= */

    document.addEventListener(
      "mouseleave",
      () => {
        cursorGlow.classList.remove(
          "visible"
        );
      }
    );


    document.addEventListener(
      "mouseenter",
      () => {
        cursorGlow.classList.add(
          "visible"
        );
      }
    );
  }
</script>


<style>
  .cursor-glow {
    position: fixed;

    top: 0;
    left: 0;

    width: 550px;
    height: 550px;

    z-index: 1;

    pointer-events: none;

    background:
      radial-gradient(
        circle at center,
        rgba(6, 182, 212, 0.13) 0%,
        rgba(139, 92, 246, 0.08) 28%,
        rgba(59, 130, 246, 0.035) 48%,
        transparent 70%
      );

    filter:
      blur(12px);

    mix-blend-mode:
      screen;

    opacity: 0;

    transition:
      opacity 0.4s ease;

    will-change:
      transform,
      opacity;
  }


  .cursor-glow.visible {
    opacity: 1;
  }


  /* Desktop only */

  @media (max-width: 1023px) {
    .cursor-glow {
      display: none;
    }
  }


  /* Reduced Motion */

  @media (
    prefers-reduced-motion:
    reduce
  ) {
    .cursor-glow {
      display: none;
    }
  }
</style>